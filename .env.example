POSTGRES_USER=scheduler
POSTGRES_PASSWORD=change_me
POSTGRES_DB=scheduler_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://scheduler:change_me@localhost:5432/scheduler_db
API_KEY=replace_with_your_own_secret

# ------------------------------------------------------------
# Optional: observability & safety tuning (sane defaults if unset)
# ------------------------------------------------------------

# Logging verbosity for both the API and worker (JSON logs to stdout).
LOG_LEVEL=INFO

# Requests allowed per client IP per window on write endpoints
# (POST /jobs, POST /workers/scale). Per-process only -- see README.
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Per-job resource caps enforced by the worker (defense in depth,
# not a full sandbox -- see README "Security notes").
JOB_MAX_MEMORY_MB=512
JOB_MAX_CPU_SECONDS=280
JOB_TIMEOUT_SECONDS=300